# Supabase (Project settings -> API). Either the legacy anon/service_role JWT keys
# or the newer publishable/secret keys work in these variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Minutes of inactivity before an officer must log in again (5-240, default 30).
INACTIVITY_MINUTES=30
# Max login attempts per IP per 15 minutes (default 20).
LOGIN_MAX_ATTEMPTS_PER_IP=20

# Only used by `npm run seed:admin` (first admin). Do not keep in production env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
