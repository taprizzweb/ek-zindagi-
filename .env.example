# Supabase (Project settings -> API). Either the legacy anon/service_role JWT keys
# or the newer publishable/secret keys work in these variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Minutes of inactivity before an officer must log in again (5-240, default 30).
INACTIVITY_MINUTES=30
# Max login attempts per IP per 15 minutes (default 20).
LOGIN_MAX_ATTEMPTS_PER_IP=20

# Only used by `npm run seed:admin` (first admin). Do not keep in production env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# --- Officer form (milestone 2) ---
# Secret for hashing phone numbers (duplicate check and opt-out list). 32+ random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later breaks duplicate detection and the opt-out list, so keep it.
PHONE_HASH_SECRET=
# Same number cannot receive a second certificate within this many hours.
DEDUPE_HOURS=24
ENTRY_MAX_PER_OFFICER_HOUR=60
ENTRY_MAX_PER_OFFICER_DAY=300
ENTRY_MAX_PER_IP_HOUR=200
# Allow "Camera not working? Use gallery" (entries are flagged for supervisor review).
ALLOW_GALLERY_FALLBACK=true
# Reverse geocoding: none (officer types the place) or google (needs GOOGLE_MAPS_API_KEY).
GEOCODER=none
GOOGLE_MAPS_API_KEY=
# Personal data (name, number, photo, PDF) is deleted after this many hours (max 168).
RETENTION_HOURS=24

# --- Certificate PDF (milestone 3) ---
# Local development / tests: path to a Chrome or Chromium binary. Leave empty on Vercel, where
# the bundled serverless Chromium is used.
CHROMIUM_EXECUTABLE_PATH=
# Rajasthan Police name and logo appear on the certificate ONLY when this is exactly "true".
# Keep it false until written permission is in hand.
SHOW_POLICE_BRANDING=false
# Logos are PNG or JPEG files inside this project folder (max 300 KB), e.g. assets/branding/ngo.png
NGO_LOGO_PATH=
POLICE_LOGO_PATH=
# Shown as "Technology Partner: ..." in the footer when set (max 80 characters).
PARTNER_CREDIT_TEXT=
