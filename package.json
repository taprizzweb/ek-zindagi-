    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "@sparticuz/chromium": "^153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
