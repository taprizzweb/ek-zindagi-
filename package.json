    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "pg": "^8.23.1",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
